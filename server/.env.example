# Supabase: Connect > Direct > Connection string > Session pooler (IPv4, works on Render)
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
# Any long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
APP_TIMEZONE=Asia/Karachi
PORT=3000
NODE_ENV=development
